{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankx.ai/schemas/weekly-packet.v1.json",
  "title": "Weekly Time OS Packet v1",
  "type": "object",
  "required": ["v", "week_id", "generated_at", "timezone", "status"],
  "properties": {
    "v": { "const": 1 },
    "week_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "examples": ["Europe/Amsterdam"] },
    "status": { "enum": ["draft", "ready", "human-approved", "archived"] },
    "top_outcomes_last_week": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 7
    },
    "pareto_vital_few": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cluster", "share_of_outcome"],
        "properties": {
          "cluster": { "type": "string" },
          "share_of_outcome": { "type": "number" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "kill_or_automate": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_week_bets": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5
    },
    "deep_work_blocks_proposed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "day": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "lane": { "type": "string" }
        }
      }
    },
    "market_events": { "type": "array", "items": { "type": "string" } },
    "research_insights": { "type": "array", "items": { "type": "string" } },
    "operator_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Time patterns from elite operators (sourced)"
    },
    "psych_cycle_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-clinical attention/energy cautions"
    },
    "artifact_paths": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
